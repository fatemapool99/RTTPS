# ========================================================
# RTTPS - Environment Configuration Template
# ========================================================

# Backend Service (Node.js / Express)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/rttps
JWT_SECRET=rttps_production_super_secret_jwt_key_2026
ML_SERVICE_URL=http://127.0.0.1:8000

# Machine Learning Service (Python / FastAPI)
ML_HOST=127.0.0.1
ML_PORT=8000

# Frontend Service (React / Vite)
# Default development proxy redirects /api and /socket.io to http://localhost:5000
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
